{
  "expo": {
    "name": "Jali",
    "slug": "jali",
    "scheme": "jali",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0055CC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jali.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Jali uses your location to calculate the service fee based on your distance to the nearest bus station.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Jali uses your location to calculate the service fee based on your distance to the nearest bus station."
      }
    },
    "android": {
      "package": "com.jali.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0055CC"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0055CC"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-web-browser",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2dd83387-a796-4ed0-841a-2093ecd11fcf"
      }
    },
    "owner": "sebastien12"
  }
}
