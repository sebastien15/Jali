# Change APP_ENV to switch modes:
#   dev  — mock data only, no backend, works in Expo Go
#   test — mock data + real actions (native libs must be compiled)
#   prod — real API only, no mocks
EXPO_PUBLIC_APP_ENV=test
# EXPO_PUBLIC_API_URL=http://192.168.0.161:8000/api
EXPO_PUBLIC_API_URL=http://localhost:8000/api
